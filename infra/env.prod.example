# Set BACKEND_IMAGE to your Docker Hub image on EC2 (e.g. mayuresh/chainsight-backend:latest).
# Leave unset locally and `docker compose build` will build from source.
BACKEND_IMAGE=

POSTGRES_DB=chainsight
POSTGRES_USER=chainsight_user
POSTGRES_PASSWORD=change-this-long-random-password
JWT_SECRET=change-this-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400

ETH_RPC_URL=https://your-provider-url
ETH_CHAIN_ID=1
ETH_INGESTION_MAX_RANGE_SIZE=100
ETH_JOB_COORDINATOR_CORE_POOL_SIZE=1
ETH_JOB_COORDINATOR_MAX_POOL_SIZE=2
ETH_JOB_COORDINATOR_QUEUE_CAPACITY=10
ETH_INGESTION_CORE_POOL_SIZE=4
ETH_INGESTION_MAX_POOL_SIZE=8
ETH_INGESTION_QUEUE_CAPACITY=50
ETH_RECEIPT_CORE_POOL_SIZE=8
ETH_RECEIPT_MAX_POOL_SIZE=16
ETH_RECEIPT_QUEUE_CAPACITY=200

INGESTION_LOCK_TTL_SECONDS=900
API_RATE_LIMIT_CAPACITY=60
API_RATE_LIMIT_REFILL_TOKENS_PER_SECOND=1
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_REFILL_TOKENS_PER_SECOND=1
API_RATE_LIMIT_KEY_TTL_SECONDS=120
ANALYTICS_CACHE_TTL_SECONDS=300
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized
